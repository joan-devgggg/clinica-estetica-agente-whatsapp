# Copia este archivo como .env y rellena los valores

OPENAI_API_KEY=sk-proj-...

# Supabase (base de datos y dashboard)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Organizaciones (multi-tenant)
# UUID de cada org (de los seeds SQL)
SANREMO_ORG_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890
SANTE_ORG_ID=b2c3d4e5-f6a7-8901-bcde-f12345678901

# Número WhatsApp de cada org (sin + ni espacios)
SANREMO_WA_PHONE=34667474233
SANTE_WA_PHONE=34641029104

# Fallback: org por defecto si no se especifica (backward compat)
ORGANIZATION_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890

# ─── Canal de WhatsApp ───────────────────────────────────────────────────────
# San Remo va por whatsapp-web.js (sesión enlazada a un móvil, QR al arrancar).
# Sante va por 360dialog (Cloud API): su ENTRANTE llega por webhook, no por wwebjs.
# El canal está fijado en services/org-registry.js a propósito, NO se deriva de la
# API key: una máquina sin la key volvería a levantar el cliente wwebjs de Sante y
# reabriría la doble entrada sobre el mismo número.
#
# Escape hatch de rollback sin deploy (devuelve Sante a whatsapp-web.js):
# SANTE_CHANNEL=wwebjs

# 360dialog — credenciales de Sante. Necesarias en TODA máquina que deba ENVIAR
# como Sante (bot, panel, recordatorios, reseñas). Sin ellas los envíos fallan.
SANTE_360_API_KEY=
SANTE_360_PHONE_NUMBER_ID=
# Opcional; por defecto https://waba-v2.360dialog.io
WHATSAPP_360_BASE_URL=

# Token secreto en la URL del webhook entrante: https://<host>/webhook/360dialog/<token>
# Es lo único que protege esa ruta (360dialog es server-to-server y no manda Bearer).
# Genera uno fuerte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_WEBHOOK_TOKEN=

# ── Enlace público de reserva ────────────────────────────────────────────────
# Secreto compartido entre el Next (Vercel) y Express (Railway). Las rutas
# /reserva-web/* están en internet: esto es lo ÚNICO que distingue una llamada de
# NUESTRA página de un curl de cualquiera. Mismo papel que WHATSAPP_WEBHOOK_TOKEN.
#
# SIN ESTA VARIABLE LAS RUTAS RESPONDEN 404 A TODO. Es deliberado: una superficie
# pública a medio configurar se queda cerrada, nunca abierta.
#
# Va en los DOS sitios con el MISMO valor, y en el Next SIN el prefijo NEXT_PUBLIC_
# (eso lo inlinearía en el bundle que se descarga el navegador — o sea, publicaría
# el secreto en el código fuente de la página).
# Genera uno fuerte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESERVA_WEB_TOKEN=

# Dashboard (protege la API REST interna)
# Genera un secreto fuerte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_API_SECRET=cambia_esto_por_un_secreto_seguro

# Telegram (panel de administración — mismo bot para ambas orgs)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# IDs de admins por defecto (se complementa con config.telegram_admins en la BD por org)
TELEGRAM_ALLOWED_USERS=123456789,987654321

PORT=3000
